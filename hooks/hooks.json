{
  "description": "Gates remote git/gh operations behind the user-invoked /submit-pr skill",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/gate-remote.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
